@model List<TechStoreMVC.Models.Categoria>

@{
    ViewData[index: "Title"] = "Categoria";
}
<h1>
    Lista de Categorias
</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Ativa</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var categoria in Model)
    {
        <tr>
            <td>@categoria.Id</td>
            <td>@categoria.Nome</td>
            <td>@categoria.Descricao</td>
            <td>@categoria.Ativa</td>
            <td>
                <button class="btn btn-primary">Detalhes</button>
            </td>
        </tr>
    }
    </tbody>
</table>
</table>